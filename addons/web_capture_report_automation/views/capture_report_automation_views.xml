<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="web_capture_report_automation_view_form" model="ir.ui.view">
            <field name="name">web.capture.report.automation.view.form</field>
            <field name="model">web.capture.report.automation</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <button string="Send Mail" name="report_send_mail" type="object" class="oe_highlight"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="report_file" filename="name"/>
                        </group>

                        <label for="report_view"/>
                        <field name="report_view"
                            filename="report_view_name"
                            widget="image" nolabel="1"/>
                        <field name="report_view_name" invisible="1"/>

                    </sheet>
                </form>
            </field>
        </record>       

        <record id="web_capture_report_automation_action" model="ir.actions.act_window">
            <field name="name">Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">web.capture.report.automation</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': 0}</field>
        </record>

        <menuitem id="web_capture_report_automation_menu_act" name="Report" parent="web_capture_report.web_capture_report_menu_categ" action="web_capture_report_automation_action" sequence="2"/>
    
    </data>
    

</odoo>
