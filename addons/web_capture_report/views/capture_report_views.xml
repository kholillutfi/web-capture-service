<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="view_web_capture_report_form" model="ir.ui.view">
            <field name="name">web.capture.report.form</field>
            <field name="model">web.capture.report</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_capture" type="object" class="btn-primary" string="Capture Now"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="capture_url" widget="url"/>
                                <field name="fullpage"/>
                                <field name="convert_pdf"/>
                                <field name="pdf_file" filename="name" attrs="{'invisible': [('convert_pdf','=',False)]}"/>
                            </group>

                            <group string="Page Resolution">
                                <label for="viewport_width"/>
                                <div class="o_row">
                                    <field name="viewport_width" class="oe_inline"/>
                                    <span class="oe_inline ms-1">px</span>
                                </div>

                                <label for="viewport_height"/>
                                <div class="o_row">
                                    <field name="viewport_height" class="oe_inline"/>
                                    <span class="oe_inline ms-1">px</span>
                                </div>
                            </group>

                            <group string="Crop Capture" attrs="{'invisible': [('fullpage','=', True)]}">
                                <label for="crop_width"/>
                                <div class="o_row">
                                    <field name="crop_width" class="oe_inline"/>
                                    <span class="oe_inline ms-1">px</span>
                                </div>

                                <label for="crop_height"/>
                                <div class="o_row">
                                    <field name="crop_height" class="oe_inline"/>
                                    <span class="oe_inline ms-1">px</span>
                                </div>

                                <label for="crop_y"/>
                                <div class="o_row">
                                    <field name="crop_y" class="oe_inline"/>
                                    <span class="oe_inline ms-1">px</span>
                                </div>
                                
                                <label for="crop_x"/>
                                <div class="o_row">
                                    <field name="crop_x" class="oe_inline"/>
                                    <span class="oe_inline ms-1">px</span>
                                </div>
                                

                            </group>
                        </group>
                        
                        <label for="screenshot_file"/>
                        <field name="screenshot_file"
                            filename="screenshot_filename"
                            widget="image" nolabel="1"/>
                        <field name="screenshot_filename" invisible="1"/>

                    </sheet>

                </form>
            </field>
        </record>

        <record id="web_capture_report_action" model="ir.actions.act_window">
            <field name="name">Web Captures</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">web.capture.report</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Web Capture records yet
                </p><p class="text-muted">
                    Click "Create" to add a new capture request and generate a screenshot of a web page.
                </p>
            </field>
        </record>

    </data>
    

</odoo>
